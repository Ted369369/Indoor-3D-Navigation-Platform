# Copy to .env and fill in. Never commit the real .env.

# HiveMQ Cloud (Overview page of your cluster)
MQTT_HOST=xxxxxxxx.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_TLS=1
MQTT_USER=engine
MQTT_PASS=changeme

# Supabase (optional - session logging). Settings > API.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Tunables
MAX_ACTIVE_USERS=5
PUBLISH_HZ=2
# MAP_MODEL_PATH=../web/data/map_model.json
